# Orcamento de recursos do container que serve a aplicacao (app-fpm / app-swoole / app-roadrunner)
APP_CPUS=1.0
APP_MEM=512m

# Orcamento do nginx (perfis FPM). NAO e uma variavel de tuning: o proxy tem
# que ser generoso o bastante para NUNCA ser o gargalo, senao o numero medido
# e o teto dele e nao o do runtime.
#
# Medido: com 0.5 CPU a rota noop do FPM parava em 1600 rps com o nginx a
# 101% do proprio limite e o FPM com 35% de CPU sobrando. Com 2.0 CPU o mesmo
# teste deu 2400 rps (+50%), com o nginx em 38% e o FPM em 87% -- ou seja, o
# gargalo finalmente virou o runtime. A varredura avisa se isso regredir.
NGINX_CPUS=2.0
NGINX_MEM=64m

# Orcamento do gerador de carga (k6). Derivado de APP_CPUS/APP_MEM pelos
# scripts, usando load_generator_multiplier de performance.json (5x), e
# exportado para o compose -- por isso nao aparece fixado aqui. Fixar um valor
# quebraria a proporcao assim que o orcamento da aplicacao mudasse, e o k6
# nunca pode ser o gargalo. Defina na shell para forcar um valor pontual:
#   K6_CPUS=1.0 ./benchmark.sh

# Portas expostas no host, uma por runtime, para poder subir os 3 ao
# mesmo tempo (docker compose --profile all up -d --build) sem conflito de
# porta ao testar/comparar manualmente.
FPM_PORT=8081
SWOOLE_PORT=8082
ROADRUNNER_PORT=8083
LARAVEL_FPM_PORT=8084
LARAVEL_OCTANE_SWOOLE_PORT=8085
LARAVEL_OCTANE_ROADRUNNER_PORT=8086
FRANKENPHP_PORT=8087
FRANKENPHP_WORKER_PORT=8088

# Dependencia simulada da rota external_io. O delay casa com o do
# blocking_wait de proposito: as duas rotas viram um par controlado -- mesma
# espera, uma simulada com usleep e outra sobre um socket de verdade.
STUB_DELAY_MS=10

# Orcamento do stub. Generoso porque ele NUNCA pode ser o gargalo; se saturar,
# mede-se o stub e nao o runtime.
STUB_CPUS=2.0
STUB_MEM=512m

# Versao do PHP usada nas imagens que aceitam o build arg (fase 9).
PHP_VERSION=8.3

# Orcamento de workers, IGUAL para os 6 runtimes -- e esse o ponto: com a
# mesma cota, a diferenca medida pertence ao modelo de concorrencia, e nao a
# um numero escolhido por runtime.
#
# Normalmente voce NAO edita isto: os scripts de benchmark calculam o valor a
# partir de APP_CPUS (workers_per_cpu em performance.json) e exportam, para
# que a proporcao se mantenha quando o orcamento variar. O valor abaixo e so
# o default de quem sobe o compose na mao.
APP_WORKERS=4

# Requests que um worker atende antes de ser reciclado. IGUAL para os 6:
# reciclar custa um bootstrap completo, e a politica era inconsistente antes
# (FPM reciclava a cada 500, Swoole vanilla nunca), o que penalizava
# silenciosamente quem reciclava.
APP_MAX_REQUESTS=500

# Pool de threads do FrankenPHP em worker mode. Tem que ser MAIOR que
# APP_WORKERS -- o servidor se recusa a subir caso contrario. A thread extra e
# exigencia estrutural dele, nao capacidade a mais: o numero comparado entre os
# runtimes continua sendo APP_WORKERS. Os scripts calculam como APP_WORKERS+1.
APP_THREADS=5

# Task workers do Octane/Swoole. Fixo pelo mesmo motivo: o default "auto" do
# Octane resolve para o numero de cores do HOST, ignorando o limite do
# container.
APP_TASK_WORKERS=1

# Perfil de tuning do PHP (fase 6): baseline | jit | preload.
# Aplica-se igualmente aos 3 runtimes; ver docker/shared/tuning/.
PHP_TUNING=baseline
