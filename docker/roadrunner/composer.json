{
    "name": "php-runtime-lab/roadrunner",
    "description": "RoadRunner PSR-7 worker entrypoint for the php-runtime-lab benchmark app",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "spiral/roadrunner": "~2025.1.0",
        "spiral/roadrunner-http": "^3.6",
        "nyholm/psr7": "^1.8",
        "psr/http-factory": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "RuntimeLab\\": "app/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0",
            "ext-sockets": "8.3.0"
        }
    }
}
