# This Laravel app is a benchmark target, not a normal application: every
# deployment is configured by docker-compose.yml, which is the source of truth
# for the values below. This file exists only for running artisan locally.
#
# Laravel's stock .env.example was replaced because it advertised database,
# mail, queue and Vite settings for subsystems this app does not use — noise
# that would suggest the benchmark depends on infrastructure it never touches.

APP_NAME="PHP Runtime Lab"
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Reported in every benchmark response so a result can be attributed to the
# stack that produced it. Set per service in docker-compose.yml.
BENCHMARK_RUNTIME=laravel

# Logs go to stderr so the container runtime collects them; nothing is written
# to disk during a measurement.
LOG_CHANNEL=stderr

# No database, no filesystem sessions, no queue worker: anything that would
# add I/O the benchmark is not trying to measure is kept in memory.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
